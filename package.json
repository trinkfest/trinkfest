{
  "name": "trinkfest",
  "version": "0.1.0",
  "private": true,
  "description": "TrinkFest, Trinkspiele-App",
  "scripts": {
    "start": "npx serve .",
    "build": "node scripts/build.js",
    "sync": "npm run build && npx cap sync && node scripts/splash.js",
    "ios": "npm run sync && npx cap open ios",
    "android": "npm run sync && npx cap open android",
    "release-check": "node scripts/release-check.js",
    "graphify-prep": "node scripts/graphify-prep.js",
    "find": "node scripts/tf-find.js",
    "prepare": "git config core.hooksPath .githooks || true",
    "codemap": "node scripts/codemap.js",
    "cards": "node scripts/tf-cards.js",
    "test-duel": "node scripts/tf-test-duel.js",
    "overflow": "node scripts/tf-overflow.js",
    "replace": "node scripts/tf-replace.js"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capgo/native-purchases": "^8.9.16",
    "@fontsource/montserrat": "^5.0.0",
    "@supabase/supabase-js": "^2.0.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
