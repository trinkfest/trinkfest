#!/bin/sh
# Nach jedem Commit: Code-Karte (Graphify) im Hintergrund aktualisieren. Kostet keine KI-Tokens.
cd "$(git rev-parse --show-toplevel)" || exit 0
(
  [ -d analyse/js ] || node scripts/graphify-prep.js >/dev/null 2>&1
  if command -v graphify >/dev/null 2>&1; then graphify update analyse >/dev/null 2>&1; fi
) &
exit 0
