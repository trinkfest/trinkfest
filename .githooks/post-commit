#!/bin/sh
# Nach jedem Commit: Code-Karte (analyse/ + Graphify) im Hintergrund aktualisieren.
# Kostet keine KI-Tokens. Ohne Graphify wird nur analyse/js/ erneuert (fuer npm run find).
cd "$(git rev-parse --show-toplevel)" || exit 0
(
  node scripts/graphify-prep.js >/dev/null 2>&1
  if command -v graphify >/dev/null 2>&1; then graphify update analyse >/dev/null 2>&1; fi
) &
exit 0
