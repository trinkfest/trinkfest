#!/bin/sh
# Vor jedem Commit: docs/CODEMAP.md (Landkarte von index.html) neu erzeugen und mit committen.
# Dauert ca. 1 s, kostet keine KI-Tokens.
cd "$(git rev-parse --show-toplevel)" || exit 0
if git diff --cached --name-only | grep -qE '^(index\.html|scripts/codemap\.js)$'; then
  node scripts/graphify-prep.js >/dev/null 2>&1 && node scripts/codemap.js >/dev/null 2>&1 && git add docs/CODEMAP.md
fi
exit 0
